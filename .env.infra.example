# ---------- General ----------
NODE_ENV=production
LOG_LEVEL=info

# ---------- Eureka (común) ----------
DISCOVERY_MODE=eureka
EUREKA_HOST=fuel-eureka
EUREKA_PORT=8761
EUREKA_BASE_PATH=/eureka
EUREKA_WAIT_TIMEOUT_MS=15000

# (default genérico; ver override por servicio más abajo)
SERVICE_BIND_HOST=0.0.0.0
SERVICE_REGISTER_HOST=fuel-api-gateway

# ---------- Rutas comunes ----------
PROTO_ROOT=../../protos
PROTOS_DIR=../../protos

# ---------- JWT ----------
JWT_SECRET=eOk1US6CvkCe3aET0Fck3amdLcR9a58mvHyNQqo+FXJhx+/a+dddddddddddddd
JWT_EXPIRES_IN=1h

# ---------- Gateway ----------
GATEWAY_APP_NAME=API-GATEWAY
GATEWAY_HTTP_PORT=8080
GRPC_CALL_TIMEOUT_MS=3000

# ---------- Hello Service ----------
HELLO_APP_NAME=HELLO-SERVICE
HELLO_GRPC_PORT=50051
HELLO_SERVICE_REGISTER_HOST=fuel-hello-svc

# ---------- Auth Service ----------
AUTH_APP_NAME=AUTH-SERVICE
AUTH_GRPC_PORT=50052
AUTH_SERVICE_REGISTER_HOST=fuel-auth-svc

# ---------- Auth database (Docker) ----------
AUTH_DB_HOST=fuel-auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASS=root
AUTH_DB_NAME=auth
AUTH_DATABASE_URL=postgresql://postgres:root@fuel-auth-db:5432/auth

# ---------- Email Service ----------
EMAIL_APP_NAME=EMAIL-SERVICE
EMAIL_GRPC_PORT=50053
EMAIL_SERVICE_REGISTER_HOST=fuel-email-svc

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=josuegarcab2@gmail.com
SMTP_PASS=
# Si este URL va en correos, deja localhost (es para el usuario final)
FRONTEND_URL=http://localhost:5174

# ---------- Users Service ----------
USERS_APP_NAME=USERS-SERVICE
USERS_GRPC_PORT=50057
USERS_SERVICE_REGISTER_HOST=fuel-users-srv

# ---------- Users database (Docker) ----------
USERS_DB_HOST=fuel-users-db
USERS_DB_PORT=5432
USERS_DB_USER=postgres
USERS_DB_PASS=admin
USERS_DB_NAME=users
USERS_DATABASE_URL=postgresql://postgres:admin@fuel-users-db:5432/users

# ---------- Vehicles Service ----------
VEHICLES_APP_NAME=VEHICLES-SERVICE
VEHICLES_GRPC_PORT=50055
VEHICLES_SERVICE_REGISTER_HOST=fuel-vehicles-svc

# (si tu servicio usa Prisma/Knex, define la URL explícita)
VEHICLES_DB_HOST=fuel-vehicles-db
VEHICLES_DB_PORT=5432
VEHICLES_DB_USER=postgres
VEHICLES_DB_PASS=admin
VEHICLES_DB_NAME=vehicles
VEHICLES_DATABASE_URL=postgresql://postgres:admin@fuel-vehicles-db:5432/vehicles

# ---------- Driver Service ----------
DRIVER_APP_NAME=DRIVER-SERVICE
DRIVER_HTTP_PORT=3100
DRIVER_GRPC_PORT=50062
DRIVER_NODE_ENV=production
DRIVER_SERVICE_REGISTER_HOST=fuel-driver-ms

# ---------- Driver database (Docker) ----------
DRIVER_DB_HOST=fuel-driver-db
DRIVER_DB_PORT=5432
DRIVER_DB_USER=postgres
DRIVER_DB_PASS=admin
DRIVER_DB_NAME=drivers
DRIVER_DATABASE_URL=postgresql://postgres:admin@fuel-driver-db:5432/drivers
DRIVER_DB_SYNCHRONIZE=false
DRIVER_DB_LOGGING=false

# ---------- Logger Service ----------
LOGGER_GRPC_PORT=50058
LOGGER_SERVICE_REGISTER_HOST=fuel-logger-svc

# ---------- RabbitMQ / Outbox Publisher ----------
RABBITMQ_URL=amqp://guest:guest@fuel-rabbitmq:5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Exchange para todos los eventos de dominio
OUTBOX_EXCHANGE=service.events

# Bases de datos con tabla Outbox (Docker)
OUTBOX_DBS=postgresql://postgres:admin@fuel-users-db:5432/users

# Configuración del publicador de Outbox
PUBLISH_BATCH=20
POLL_MS=500
OUTBOX_PUBLISHER_PORT=4100

# ---------- Kibana (opcional) ----------
KIBANA_PORT=5601
