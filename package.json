{
  "name": "fuel-control",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "eureka:up": "docker compose up -d eureka",
    "eureka:down": "docker compose down",
    "db-auth:up": "docker compose up -d users-db",
    "db-auth:down": "docker compose down users-db -v",
    "dev": "npm run eureka:up && npm run db-auth:up && concurrently -k -n GATEWAY \"npm --workspace services/api-gateway run start:dev\"",
    "prisma:generate:all": "npx --prefix ./services/users-srv run prisma:generate && npm --prefix ./services/vehicles-svc run prisma:generate"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "concurrently": "^9.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^17.2.3",
    "eureka-js-client": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "concurrently": "^9.0.0"
  }
}
