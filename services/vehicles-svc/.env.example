# ==============================================
# Vehicles Service - Variables de Entorno
# ==============================================
# Archivo: services/vehicles-svc/.env.example
#
# Este servicio usa Prisma y necesita DATABASE_URL + SHADOW_DATABASE_URL
# para generar el cliente, ejecutar migraciones y conectarse en runtime.

# Copia este archivo como .env y ajusta según ambiente
# ==============================================

# ---------- Para DESARROLLO LOCAL ----------
DATABASE_URL=postgresql://postgres:admin@localhost:5435/vehicles?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:admin@localhost:5435/vehicles_shadow?schema=public

# Configuración de PostgreSQL (opcional, para scripts)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=vehicles

# ---------- Para DOCKER ----------
# DATABASE_URL=postgresql://postgres:admin@vehicles-db:5432/vehicles?schema=public
# SHADOW_DATABASE_URL=postgresql://postgres:admin@vehicles-db:5432/vehicles_shadow?schema=public

# ---------- Para AZURE AKS ----------
# Las URLs se construyen dinámicamente en Kubernetes:
# DATABASE_URL=postgresql://$(DB_USERNAME):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/vehicles_db?sslmode=require
# SHADOW_DATABASE_URL=postgresql://$(DB_USERNAME):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/vehicles_shadow_db?sslmode=require
#
# Kubernetes inyecta:
#   DB_HOST: fuel-system-postgres.postgres.database.azure.com
#   DB_PORT: 5432
#   DB_USERNAME: desde Secret
#   DB_PASSWORD: desde Secret


# ==============================================
# NOTAS:
# ==============================================
#
# Prisma busca DATABASE_URL en dos momentos:
# 1. BUILD TIME: npx prisma generate (necesita cualquier URL válida)
# 2. RUNTIME: La aplicación conecta (necesita URL real)
#
# SHADOW_DATABASE_URL:
# - Usado solo para migraciones en desarrollo
# - Prisma crea/destruye schemas temporales aquí
# - NO se usa en producción (Azure maneja esto diferente)
#
# El schema.prisma usa:
#   datasource db {
#     provider          = "postgresql"
#     url               = env("DATABASE_URL")
#     shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
#   }
#
# Comandos útiles:
# ----------------
# npx prisma generate              # Genera el cliente Prisma
# npx prisma migrate deploy        # Aplica migraciones
# npx prisma migrate dev           # Crea nueva migración
# npx prisma studio                # Abre GUI para ver datos
# npx prisma db push               # Sincroniza schema sin migración
# npx prisma db seed               # Ejecuta seed (si está configurado)
#
# ==============================================

